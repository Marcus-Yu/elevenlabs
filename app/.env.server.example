# Copy to app/.env.server (never committed) and fill in.
# Keys follow docs/IMPLEMENTATION_PLAN.md §11. Leave a provider key empty until your package needs it.

# --- Core ---------------------------------------------------------------
# Local Postgres: brew services start postgresql@17 && createdb atlas_dev
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/atlas_dev
ANTHROPIC_API_KEY=
# Optional model for fast calls; defaults to claude-opus-5-5.
FAST_MODEL=
# Provider calls: replay (default, reads fixtures/), record (calls the provider and writes fixtures; spends credits), live.
ADAPTER_MODE=replay
# sandbox rewrites every recipient to OUTREACH_REDIRECT_TO. Never point this at a real third party.
OUTREACH_MODE=sandbox
OUTREACH_REDIRECT_TO=
# alter | local. local is for development only and is stamped on every log row.
EXECUTION_BACKEND=local
# Public URL of the server for webhooks, e.g. from `cloudflared tunnel --url http://localhost:3001`.
PUBLIC_BASE_URL=http://localhost:3001

# --- Discovery (WP2) ----------------------------------------------------
FIBER_API_KEY=
PLOID_API_KEY=

# --- Simulation (WP3) ---------------------------------------------------
SIM_URL=http://localhost:8000

# --- ElevenLabs (WP8, WP9) ----------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_SKEPTIC_AGENT_ID=
ELEVENLABS_BRIEFING_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Alter (WP7) --------------------------------------------------------
ALTER_API_KEY=
ALTER_AGENT_KEY_PREPARE=
ALTER_AGENT_KEY_ACT=
ALTER_WEBHOOK_SECRET=

# --- TraceRoot (WP7) ----------------------------------------------------
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=

# --- Watchers (WP10) ----------------------------------------------------
MARITIME_API_KEY=
# local | maritime
WATCHER_RUNTIME=local

# --- Memory (WP12) ------------------------------------------------------
ROWBOAT_BASE_URL=
ROWBOAT_TOKEN=

# --- Optional, not in §11 -----------------------------------------------
# Fixture folder override; defaults to fixtures/ at the repository root.
# FIXTURES_DIR=
# Password for the seeded "demo" user; defaults to atlas-demo-1 (local only).
# DEMO_USER_PASSWORD=

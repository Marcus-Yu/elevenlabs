# Copy to app/.env.server (never committed) and fill in.
# Keys follow docs/IMPLEMENTATION_PLAN.md §11. Leave a provider key empty until your package needs it.

# --- Core ---------------------------------------------------------------
# Local Postgres: brew services start postgresql@17 && createdb atlas_dev
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/atlas_dev
ANTHROPIC_API_KEY=
# Optional model for fast calls; defaults to claude-opus-5-5.
FAST_MODEL=
# Optional local-only Anthropic-compatible chat server (experimental; requires tool support).
# ATLAS_CHAT_PROVIDER=local
# ATLAS_CHAT_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# ATLAS_CHAT_LOCAL_MODEL=your-local-model
# Provider calls: replay (default, reads fixtures/), record (calls the provider and writes fixtures; spends credits), live.
ADAPTER_MODE=replay
# Optional calibration profile override: live or replay. Defaults to ADAPTER_MODE.
# SIM_CALIBRATION_MODE=live
# sandbox rewrites every recipient to OUTREACH_REDIRECT_TO. Never point this at a real third party.
OUTREACH_MODE=sandbox
OUTREACH_REDIRECT_TO=
# alter | local. local is for development only and is stamped on every log row.
EXECUTION_BACKEND=local
# Public URL of the server for webhooks, e.g. from `cloudflared tunnel --url http://localhost:3001`.
PUBLIC_BASE_URL=http://localhost:3001

# --- Discovery (WP2) ----------------------------------------------------
FIBER_API_KEY=
PLOID_API_KEY=

# --- Simulation (WP3) ---------------------------------------------------
SIM_URL=http://localhost:8000
# Optional pitch/Room scoring override. Set live to use SIM_URL with discovery still in replay.
# SIM_PITCH_MODE=live

# --- Thread (WP4) -------------------------------------------------------
# Assistant Cloud server key. Not in §11; added in #3.
ASSISTANT_API_KEY=

# --- ElevenLabs (WP8, WP9) ----------------------------------------------
# Set ELEVENLABS_MODE=live to enable live voice while other providers use replay.
# ADAPTER_MODE=live also enables voice. Each live voice action spends ElevenLabs credits.
ELEVENLABS_MODE=
ELEVENLABS_API_KEY=
ELEVENLABS_SKEPTIC_AGENT_ID=
ELEVENLABS_BRIEFING_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# --- Alter (WP7) --------------------------------------------------------
# Used only when EXECUTION_BACKEND=alter. Setup: docs/ALTER_SETUP.md.
# App key (alter_rk_..., Backend service template + approvals:decide, approvals:read).
ALTER_API_KEY=
# Agent keys (alter_key_...) for the atlas-prepare and atlas-act agents.
ALTER_AGENT_KEY_PREPARE=
ALTER_AGENT_KEY_ACT=
# Optional: agent UUIDs for scripts/alter-connect.ts (defaults to the agent names).
ALTER_AGENT_ID_PREPARE=
ALTER_AGENT_ID_ACT=
# Google grant id printed by scripts/alter-connect.ts (optional; without it Alter resolves by provider).
ALTER_GOOGLE_GRANT_ID=
# The approver's email in Alter; Atlas records the user's in-app approval in Alter as this person.
ALTER_APPROVER_EMAIL=
# Optional: webhooks are not used for the demo (Atlas waits with awaitApproval).
ALTER_WEBHOOK_SECRET=
# Personal access token for the Alter CLI. Not in §11; added in #3.
ALTER_PAT=

# --- TraceRoot (WP7) ----------------------------------------------------
# Tracing is off when TRACEROOT_API_KEY is empty. Host defaults to https://app.traceroot.ai.
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=
TRACEROOT_ENVIRONMENT=development

# --- Watchers (WP10) ----------------------------------------------------
MARITIME_API_KEY=
# local | maritime
WATCHER_RUNTIME=local

# --- Memory (WP12) ------------------------------------------------------
ROWBOAT_BASE_URL=
ROWBOAT_TOKEN=

# --- Optional, not in §11 -----------------------------------------------
# Fixture folder override; defaults to fixtures/ at the repository root.
# FIXTURES_DIR=
# Password for the seeded "demo" user; defaults to atlas-demo-1 (local only).
# DEMO_USER_PASSWORD=

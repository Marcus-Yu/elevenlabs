# Copy to app/.env.server (never committed) and fill in.
# Keys for later packages are added from docs/IMPLEMENTATION_PLAN.md §11 as each package needs them.

# Local Postgres: brew services start postgresql@17 && createdb atlas_dev
DATABASE_URL=postgresql://YOUR_OS_USER@localhost:5432/atlas_dev

# Provider calls: replay (default, reads fixtures/), record (calls the provider and writes fixtures; spends credits), live.
ADAPTER_MODE=replay

# Optional. Defaults to the fixtures/ folder at the repository root.
# FIXTURES_DIR=

# Application and service settings.
ANTHROPIC_API_KEY=
FAST_MODEL=
OUTREACH_MODE=sandbox
OUTREACH_REDIRECT_TO=
EXECUTION_BACKEND=
PUBLIC_BASE_URL=
SIM_URL=

# Server-side provider credentials.
FIBER_API_KEY=
PLOID_API_KEY=
ASSISTANT_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_SKEPTIC_AGENT_ID=
ELEVENLABS_BRIEFING_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ALTER_API_KEY=
ALTER_AGENT_KEY_PREPARE=
ALTER_AGENT_KEY_ACT=
ALTER_WEBHOOK_SECRET=
# Personal access token for the Alter CLI.
ALTER_PAT=
TRACEROOT_API_KEY=
TRACEROOT_HOST_URL=
MARITIME_API_KEY=
WATCHER_RUNTIME=
ROWBOAT_BASE_URL=
ROWBOAT_TOKEN=
